# ============================================
# Clinic Management System (CMS) - Environment Configuration
# ============================================
# Copy this file to .env and update with your settings.

# Application Settings
DEBUG=True
SECRET_KEY=Change-Me-To-A-Strong-Secret-Key
SITE_DOMAIN=http://localhost:8000

# Database: use 'sqlite' for local Windows/Mac dev (no Docker needed)
# Use 'postgresql' only when running with Docker Compose
database_type=sqlite

# PostgreSQL (Docker Compose only — settings.py reads POSTGRES_* env vars)
POSTGRES_DB=cms_db
POSTGRES_USER=cms_user
POSTGRES_PASSWORD=cms_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# Optional: Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: Email SMTP
MAIL_USER=
MAIL_PASSWORD=
