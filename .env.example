# ============================================
# Clinic Management System (CMS) - Environment Configuration
# ============================================
# Copy this file to .env and update with your settings:
#   cp .env.example .env

# ============================================
# Application Settings
# ============================================
# Set to True for development, False for production
DEBUG=True

# Django secret key - Generate a new one for production: https://djecrety.ir/
SECRET_KEY='Change-Me-To-A-Strong-Secret-Key'

# Your site domain (used for OAuth callbacks and emails)
# Examples:
#   Development: http://localhost:8000
#   Production: https://your-clinic-domain.com
SITE_DOMAIN='http://localhost:8000'

# Email verification requirement:
# Set to False for instant login on registration (recommended for local testing)
# Set to True to enforce activation link verification before login
REQUIRE_EMAIL_VERIFICATION=False

# ============================================
# Database Configuration
# ============================================
# Database type: 'sqlite' (easiest zero-config for testing) or 'postgresql'
database_type='sqlite'

# PostgreSQL Database Settings (used when database_type='postgresql')
DATABASE_NAME='cms_db'
DATABASE_USER='cms_user'
DATABASE_PASSWORD='cms_password'
DATABASE_HOST='localhost'  # Use 'localhost' for local Postgres, or 'db' for Docker
DATABASE_PORT='5432'      # Default Postgres port ('5433' if connecting to docker container from host)

# ============================================
# Google OAuth 2.0 (Optional)
# ============================================
# Create credentials at: https://console.cloud.google.com/apis/credentials
# Authorized Redirect URI: http://localhost:8000/google/callback/
# Leave empty to disable Google authentication
GOOGLE_CLIENT_ID=''
GOOGLE_CLIENT_SECRET=''

# ============================================
# Email Configuration (Optional - SMTP)
# ============================================
# Used for password reset and account verification emails
# Supports Gmail, Outlook, or any standard SMTP server
# For Gmail: Use an App Password (not your regular password)
# Generate at: https://myaccount.google.com/apppasswords
MAIL_USER=''
MAIL_PASSWORD=''

# ============================================
# End of Configuration
# ============================================